@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mt-5">
    <h1 class="display-4">Bem-vindo à LojaMVC 🛍️</h1>

    <p class="lead">
        Gerencie seus clientes e produtos de forma simples e organizada.
    </p>

    <div class="mt-4">
        <a asp-controller="Produto"
           asp-action="Index"
           class="btn btn-primary">
            Ver produtos
        </a>

        <a asp-controller="Cliente"
           asp-action="Index"
           class="btn btn-outline-primary ms-2">
            Ver clientes
        </a>
    </div>
</div>
